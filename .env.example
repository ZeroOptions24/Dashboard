# Kopie als .env.local anlegen und ausfüllen. .env.local wird NICHT committet.

# Datenquelle für die Leads: "demo" (Beispieldaten) oder "pipedrive"
NEXT_PUBLIC_DATA_SOURCE=demo

# Persönlicher API-Token aus Pipedrive:
# Pipedrive → Profilbild oben rechts → Persönliche Einstellungen → API
# Bleibt auf dem Server, wird nie an den Browser ausgeliefert.
PIPEDRIVE_API_TOKEN=
