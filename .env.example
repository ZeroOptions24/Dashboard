# Kopie als .env.local anlegen und ausfüllen. .env.local wird NICHT committet.
# Werte mit (Pflicht) müssen auf dem Server gesetzt sein.

# ---------- App & Login ----------
# Öffentliche Adresse der App (lokal http://localhost:3000) – wird in Links in E-Mails verwendet
BETTER_AUTH_URL=http://localhost:3000
# (Pflicht) Zufälliger Schlüssel für Sitzungen: openssl rand -base64 32
BETTER_AUTH_SECRET=
# (Pflicht) Schlüssel für verschlüsselte Felder (IBAN), 32 Byte: openssl rand -base64 32
# ACHTUNG: Geht dieser Schlüssel verloren, sind gespeicherte IBANs nicht mehr lesbar.
DATA_ENCRYPTION_KEY=

# ---------- Datenbank ----------
# Lokal leer lassen – `npm run dev` startet die Datenbank und setzt DATABASE_URL selbst.
# Auf dem Server: PostgreSQL-URL, z. B. postgres://user:passwort@host:5432/dashboard
DATABASE_URL=

# ---------- E-Mail (TODO EnergyEngel: Absender festlegen) ----------
# Leer = keine echten Mails, nur Anzeige unter /dev/postfach
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="EnergyEngel <team@energyengel.com>"

# ---------- Elektronische Unterschrift (TODO EnergyEngel: Yousign-Konto) ----------
# dev = simulierte Unterschrift unter /dev/unterschrift/…, yousign = echt
SIGNING_PROVIDER=dev
YOUSIGN_API_KEY=
YOUSIGN_WEBHOOK_SECRET=
# 1 = Yousign-Testumgebung
YOUSIGN_SANDBOX=1

# ---------- Pipedrive ----------
# Datenquelle für die Leads: "demo" (Beispieldaten) oder "pipedrive"
NEXT_PUBLIC_DATA_SOURCE=demo
# Persönlicher API-Token: Pipedrive → Persönliche Einstellungen → API. Bleibt auf dem Server.
PIPEDRIVE_API_TOKEN=
